theme = Carbonfox

background-opacity = 0.85
background-blur-radius = 20
window-colorspace = display-p3
minimum-contrast = 1.1
bold-is-bright = true

font-family = JetBrainsMonoNL Nerd Font
font-size = 13
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true

macos-titlebar-style = hidden
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 14
window-padding-y = 14
window-padding-balance = false

auto-update = check
auto-update-channel = stable

shell-integration-features = no-cursor
term = xterm-256color
copy-on-select = clipboard

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

keybind = super+i=inspector:toggle

keybind = super+enter=csi:13;2u

keybind = super+grave_accent=toggle_quick_terminal

keybind = super+n=new_window

keybind = super+d=text:\x02%
keybind = super+shift+d=text:\x02\x22
keybind = super+shift+e=text:\x02E
keybind = super+t=text:\x02c
keybind = super+w=text:\x02x
keybind = super+p=text:\x02P
keybind = super+1=text:\x021
keybind = super+2=text:\x022
keybind = super+3=text:\x023
keybind = super+4=text:\x024
keybind = super+5=text:\x025
keybind = super+6=text:\x026
keybind = super+7=text:\x027
keybind = super+8=text:\x028
keybind = super+9=text:\x029
keybind = super+h=text:\x08
keybind = super+j=text:\x0a
keybind = super+k=text:\x0b
keybind = super+l=text:\x0c

keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+shift+enter=unbind
keybind = super+alt+w=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+==unbind

window-height = 41
window-width = 149

window-save-state = always

macos-option-as-alt = false
